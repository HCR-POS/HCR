.toast.show{opacity:1;transform:translate(-50%,0);}

/* ==================== 特效 ==================== */
.flash{
  position:absolute;inset:0;
  pointer-events:none;z-index:400;
  background:radial-gradient(circle at 50% 28%,rgba(255,209,102,.85),transparent 55%);
  animation:flashOut .9s ease-out forwards;
}
@keyframes flashOut{
  0%{opacity:0;}
  18%{opacity:1;}
  100%{opacity:0;}
}
.particle{
  position:absolute;width:7px;height:7px;border-radius:50%;
  pointer-events:none;z-index:401;
  animation:burst 1.3s cubic-bezier(.2,.8,.4,1) forwards;
}
@keyframes burst{
  0%{transform:translate(-50%,-50%) scale(1.3);opacity:1;}
  100%{transform:translate(calc(-50% + var(--x)),calc(-50% + var(--y))) scale(0);opacity:0;}
