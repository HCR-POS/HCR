<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0a0a1a">
<title>幸运32兽</title>
<style>
*{margin:0;padding:0;box-sizing:border-box;-webkit-tap-highlight-color:transparent;}
html,body{
  width:100%;height:100%;overflow:hidden;
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;
  background:#07070f;color:#fff;
  -webkit-user-select:none;user-select:none;
  -webkit-touch-callout:none;
}
#app{
  position:relative;
  display:flex;flex-direction:column;
  width:100%;height:100%;max-width:520px;margin:0 auto;
  background:
    radial-gradient(circle at 15% 8%,rgba(124,92,255,.22),transparent 45%),
    radial-gradient(circle at 85% 92%,rgba(255,209,102,.14),transparent 45%),
    radial-gradient(circle at 50% 50%,rgba(34,211,238,.06),transparent 70%),
    #0a0a1a;
  overflow:hidden;
}
input{-webkit-user-select:text;user-select:text;}

/* ==================== 内容滚动区 ==================== */
.content{
  flex:1;overflow-y:auto;overflow-x:hidden;
  -webkit-overflow-scrolling:touch;
  padding-bottom:calc(155px + env(safe-area-inset-bottom,0px));
}
.content::-webkit-scrollbar{display:none;}

/* ==================== 顶栏 ==================== */
.topbar{
  position:sticky;top:0;z-index:20;
  display:flex;justify-content:space-between;align-items:center;
  padding:12px 16px;
  padding-top:calc(12px + env(safe-area-inset-top,0px));
  background:rgba(10,10,26,.62);
  -webkit-backdrop-filter:blur(22px) saturate(180%);
  backdrop-filter:blur(22px) saturate(180%);
  border-bottom:1px solid rgba(255,255,255,.07);
}
.brand{
  font-size:17px;font-weight:800;letter-spacing:.5px;
  background:linear-gradient(135deg,#ffd166,#a78bfa);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.balance-box{
  display:flex;flex-direction:column;align-items:flex-end;
  padding:4px 12px;border-radius:12px;
  background:rgba(255,209,102,.09);
  border:1px solid rgba(255,209,102,.24);
  -webkit-backdrop-filter:blur(10px);
  backdrop-filter:blur(10px);
}
.balance-label{font-size:9px;color:#8a8aa8;letter-spacing:.5px;}
.balance-value{
  font-size:16px;font-weight:800;color:#ffd166;
  font-variant-numeric:tabular-nums;line-height:1.2;
  transition:color .2s,transform .2s;
}
.balance-value.bump{animation:balBump .5s ease-out;}
@keyframes balBump{
  0%{transform:scale(1);}
  40%{transform:scale(1.12);}
  100%{transform:scale(1);}
}

/* ==================== 历史条 ==================== */
.history-strip{padding:10px 0 10px 14px;}
.history-label{
  font-size:10.5px;color:#6a6a80;letter-spacing:.5px;
  margin-bottom:7px;display:flex;align-items:center;gap:5px;
}
.history-label::before{
  content:'';width:5px;height:5px;border-radius:50%;
  background:#22d3ee;box-shadow:0 0 6px #22d3ee;
}
.history-scroll{
  display:flex;gap:7px;
  overflow-x:auto;overflow-y:hidden;
  padding-right:14px;
  -webkit-overflow-scrolling:touch;
  scrollbar-width:none;
}
.history-scroll::-webkit-scrollbar{display:none;}
.hist-item{
  flex:0 0 auto;
  width:50px;
  padding:8px 4px 6px;
  border-radius:11px;
  background:rgba(255,255,255,.045);
  border:1px solid rgba(255,255,255,.08);
  text-align:center;
  transition:all .2s;
  animation:histIn .35s ease-out;
}
@keyframes histIn{
  from{opacity:0;transform:translateX(-10px);}
  to{opacity:1;transform:translateX(0);}
}
.hist-item .hist-emoji{font-size:20px;line-height:1;}
.hist-item .hist-num{
  font-size:9.5px;color:#6a6a80;margin-top:3px;
  font-variant-numeric:tabular-nums;letter-spacing:.3px;
}
.hist-item.hit{
  border-color:rgba(74,222,128,.65);
  background:rgba(74,222,128,.12);
  box-shadow:0 0 14px rgba(74,222,128,.28);
}
.hist-item.hit .hist-num{color:#4ade80;}
.hist-empty{
  font-size:11.5px;color:#5a5a70;
  padding:8px 14px 8px 0;
}

/* ==================== 开奖舞台 ==================== */
.stage{padding:6px 14px 6px;text-align:center;}
.stage-info{
  display:flex;justify-content:space-between;align-items:center;
  font-size:12px;color:#8a8aa8;margin-bottom:10px;
}
.issue{
  padding:5px 11px;background:rgba(255,255,255,.05);
  border-radius:8px;font-variant-numeric:tabular-nums;
  border:1px solid rgba(255,255,255,.06);
}
.issue b{color:#fff;}
.timer-num{
  font-size:17px;font-weight:800;color:#ffd166;
  font-variant-numeric:tabular-nums;min-width:32px;text-align:right;
  transition:color .3s;
}
.timer-num.warn{color:#ff5555;}

.progress-wrap{
  height:5px;border-radius:3px;
  background:rgba(255,255,255,.06);
  overflow:hidden;
  margin-bottom:14px;
  position:relative;
}
.progress-fill{
  height:100%;width:100%;
  border-radius:3px;
  background:linear-gradient(90deg,#ffd166,#f5a623,#ffd166);
  background-size:200% 100%;
  transition:width 1s linear,background .3s;
  animation:progressShine 2s linear infinite;
}
@keyframes progressShine{
  0%{background-position:0% 0;}
  100%{background-position:200% 0;}
}
.progress-fill.warn{
  background:linear-gradient(90deg,#ff5555,#ff3333,#ff5555);
  background-size:200% 100%;
  box-shadow:0 0 12px rgba(255,85,85,.6);
  animation:progressShine 1s linear infinite,progressBlink .9s ease-in-out infinite;
}
@keyframes progressBlink{
  0%,100%{opacity:1;}
  50%{opacity:.55;}
}

.balls{
  display:flex;justify-content:center;gap:14px;
  padding:6px 0 16px;
  position:relative;
}
.balls::before{
  content:'';position:absolute;
  top:50%;left:50%;
  width:280px;height:130px;
  transform:translate(-50%,-50%);
  background:radial-gradient(ellipse,rgba(255,209,102,.18),transparent 65%);
  filter:blur(24px);
  pointer-events:none;
}
.ball{
  width:70px;height:70px;border-radius:50%;
  background:
    radial-gradient(circle at 30% 24%,#fff8d8 0%,#ffd166 34%,#e8a11d 62%,#8b5a00 100%);
  display:flex;align-items:center;justify-content:center;
  font-size:30px;font-weight:900;color:#1a1005;
  position:relative;overflow:hidden;
  transition:transform .2s,box-shadow .25s;
  box-shadow:
    0 6px 18px rgba(255,209,102,.32),
    0 14px 38px rgba(255,209,102,.14),
    inset 0 -8px 18px rgba(0,0,0,.28),
    inset 0 6px 12px rgba(255,255,255,.35),
    inset -5px -5px 12px rgba(0,0,0,.18);
  z-index:1;
}
.ball::before{
  content:'';position:absolute;
  top:8px;left:13px;
  width:24px;height:12px;border-radius:50%;
  background:radial-gradient(ellipse at center,rgba(255,255,255,.95),rgba(255,255,255,.4) 45%,transparent 75%);
  filter:blur(1.8px);
  pointer-events:none;
  z-index:2;
}
.ball::after{
  content:'';position:absolute;
  bottom:9px;right:12px;
  width:16px;height:7px;border-radius:50%;
  background:radial-gradient(ellipse at center,rgba(255,255,255,.5),transparent 70%);
  filter:blur(2.2px);
  pointer-events:none;
  z-index:2;
}
.ball.rolling{animation:ballShake .1s infinite;}
@keyframes ballShake{
  0%,100%{transform:rotate(-5deg) scale(.98);}
  50%{transform:rotate(5deg) scale(1.02);}
}
.ball.pop{
  animation:ballPop .6s cubic-bezier(.2,1.6,.4,1);
  box-shadow:
    0 8px 26px rgba(255,209,102,.85),
    0 18px 48px rgba(255,209,102,.35),
    inset 0 -8px 18px rgba(0,0,0,.28),
    inset 0 6px 12px rgba(255,255,255,.4),
    inset -5px -5px 12px rgba(0,0,0,.18);
}
@keyframes ballPop{
  0%{transform:scale(1.35);filter:brightness(2);}
  55%{transform:scale(.95);}
  100%{transform:scale(1);filter:brightness(1);}
}

.result{
  min-height:50px;
  display:flex;align-items:center;justify-content:center;
  font-size:13px;color:#5a5a70;
  padding:0 6px;
}
.result .info{
  display:inline-flex;align-items:center;gap:10px;
  padding:10px 18px;border-radius:14px;
  background:rgba(255,255,255,.055);
  -webkit-backdrop-filter:blur(12px);
  backdrop-filter:blur(12px);
  border:1px solid rgba(255,255,255,.1);
  font-size:14px;color:#fff;
  animation:fadeIn .4s ease;
}
@keyframes fadeIn{
  from{opacity:0;transform:translateY(6px);}
  to{opacity:1;transform:translateY(0);}
}
.result .emoji{font-size:22px;line-height:1;}
.result .code{
  color:#22d3ee;font-weight:800;letter-spacing:2px;
  font-variant-numeric:tabular-nums;
}
.result .name{color:#ffd166;font-weight:800;}
.result .delta{font-weight:900;font-variant-numeric:tabular-nums;}
.result .delta.win{color:#4ade80;}
.result .delta.lose{color:#ff5555;}

/* ==================== 动物网格 ==================== */
.grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:8px;
  padding:10px 12px 16px;
}
.animal{
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  padding:9px 4px 8px;
  background:rgba(255,255,255,.04);
  -webkit-backdrop-filter:blur(8px);
  backdrop-filter:blur(8px);
  border:1px solid rgba(255,255,255,.08);
  border-radius:13px;
  cursor:pointer;
  transition:transform .12s,background .18s,border-color .18s,box-shadow .18s;
  min-height:72px;
  position:relative;
  touch-action:manipulation;
  overflow:visible;
}
.animal:active{transform:scale(.94);}
.animal.selected{
  background:linear-gradient(160deg,rgba(255,209,102,.22),rgba(255,209,102,.06));
  border-color:#ffd166;
  box-shadow:0 0 0 1px #ffd166,0 0 20px rgba(255,209,102,.38);
}
.animal.win{
  animation:winGlow 1.4s ease-out;
  border-color:#4ade80 !important;
}
@keyframes winGlow{
  0%{box-shadow:0 0 0 0 rgba(74,222,128,.95);background:rgba(74,222,128,.32);}
  100%{box-shadow:0 0 0 24px rgba(74,222,128,0);background:rgba(255,255,255,.04);}
}
.animal .emoji{font-size:24px;line-height:1;margin-bottom:3px;}
.animal .name{font-size:11.5px;color:#e8e8f0;font-weight:600;line-height:1.2;}
.animal .num{font-size:9px;color:#6a6a80;margin-top:2px;font-variant-numeric:tabular-nums;}
.animal .bet-badge{
  position:absolute;top:-5px;right:-5px;
  background:linear-gradient(135deg,#ffd166,#f5a623);
  color:#1a1005;font-size:9.5px;font-weight:900;
  padding:2px 7px;border-radius:9px;
  min-width:20px;text-align:center;
  box-shadow:0 3px 10px rgba(255,209,102,.55);
  font-variant-numeric:tabular-nums;
  z-index:3;
  animation:badgeIn .3s cubic-bezier(.2,1.6,.4,1);
}
@keyframes badgeIn{
  from{transform:scale(0);}
  to{transform:scale(1);}
}

/* ==================== 底部整合区（投注栏 + 导航栏） ==================== */
.bottom-area{
  position:absolute;
  left:0;right:0;bottom:0;
  z-index:100;
  background:rgba(10,10,24,.82);
  -webkit-backdrop-filter:blur(24px) saturate(180%);
  backdrop-filter:blur(24px) saturate(180%);
  border-top:1px solid rgba(255,255,255,.08);
  padding-bottom:env(safe-area-inset-bottom,0px);
}

/* 投注栏 */
.bet-bar{
  padding:10px 12px 8px;
}
.bet-info{
  display:flex;justify-content:space-between;align-items:center;
  margin-bottom:9px;font-size:12px;min-height:16px;
}
.bet-selected{
  color:#fff;flex:1;min-width:0;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
  font-weight:600;
}
.bet-selected.empty{color:#5a5a70;font-weight:400;}
.bet-selected .hl{color:#ffd166;font-weight:800;}
.bet-preview{
  color:#8a8aa8;font-size:11px;flex-shrink:0;
  margin-left:10px;font-variant-numeric:tabular-nums;
}
.bet-preview b{color:#4ade80;}

.bet-row{display:flex;gap:6px;align-items:center;}
.quick{display:flex;gap:4px;flex-shrink:0;}
.quick-btn{
  min-width:44px;height:40px;padding:0 9px;
  background:rgba(124,92,255,.16);
  border:1px solid rgba(124,92,255,.36);
  color:#b8a8ff;border-radius:10px;
  font-size:12.5px;font-weight:800;
  cursor:pointer;font-family:inherit;
  transition:.12s;touch-action:manipulation;
  font-variant-numeric:tabular-nums;
}
.quick-btn:active{background:rgba(124,92,255,.34);transform:scale(.95);}
.amount{
  flex:1;min-width:0;height:40px;padding:0 8px;
  background:rgba(255,255,255,.05);
  border:1px solid rgba(255,255,255,.1);
  border-radius:10px;color:#fff;
  font-size:16px;font-weight:800;
  text-align:center;outline:none;
  font-family:inherit;font-variant-numeric:tabular-nums;
  transition:border-color .15s,background .15s;
}
.amount:focus{border-color:#ffd166;background:rgba(255,209,102,.08);}
.bet-btn{
  height:40px;padding:0 20px;flex-shrink:0;
  background:linear-gradient(135deg,#ffd166,#f5a623);
  color:#1a1005;border:0;border-radius:10px;
  font-size:14.5px;font-weight:900;
  cursor:pointer;font-family:inherit;
  letter-spacing:1px;touch-action:manipulation;
  box-shadow:0 4px 14px rgba(255,209,102,.35);
  transition:.12s;
}
.bet-btn:active{transform:scale(.95);filter:brightness(1.08);}
.bet-btn:disabled{opacity:.4;box-shadow:none;transform:none;}

/* 导航栏 */
.tab-bar{
  display:flex;
  border-top:1px solid rgba(255,255,255,.07);
  padding:0 6px;
}
.tab-item{
  flex:1;
  display:flex;flex-direction:column;
  align-items:center;justify-content:center;
  gap:3px;
  padding:9px 4px 7px;
  background:transparent;
  border:0;
  color:#6a6a80;
  font-family:inherit;
  cursor:pointer;
  transition:transform .15s,color .2s;
  position:relative;
  touch-action:manipulation;
  min-height:56px;
}
.tab-item:active{transform:scale(.94);}
.tab-item .tab-icon{
  font-size:22px;line-height:1;
  filter:grayscale(.55) brightness(.9);
  transition:.22s;
}
.tab-item .tab-label{
  font-size:10.5px;font-weight:700;
  letter-spacing:.4px;
  transition:.2s;
}
.tab-item.active{color:#ffd166;}
.tab-item.active .tab-icon{
  filter:grayscale(0) brightness(1.1);
  transform:scale(1.15) translateY(-1px);
  filter:drop-shadow(0 3px 10px rgba(255,209,102,.6));
}
.tab-item.active .tab-label{
  color:#ffd166;
  letter-spacing:.6px;
}
.tab-item.active::before{
  content:'';
  position:absolute;
  top:0;left:50%;
  transform:translateX(-50%);
  width:30px;height:3px;
  border-radius:0 0 3px 3px;
  background:linear-gradient(90deg,#ffd166,#f5a623);
  box-shadow:0 0 12px rgba(255,209,102,.75);
}

/* ==================== 面板遮罩 ==================== */
.panel-mask{
  position:absolute;inset:0;
  background:rgba(0,0,0,.68);
  -webkit-backdrop-filter:blur(4px);
  backdrop-filter:blur(4px);
  opacity:0;pointer-events:none;
  transition:opacity .3s;
  z-index:150;
}
.panel-mask.show{opacity:1;pointer-events:auto;}

/* ==================== 面板 ==================== */
.panel{
  position:absolute;left:0;right:0;bottom:0;
  max-height:82%;
  background:rgba(20,20,40,.94);
  -webkit-backdrop-filter:blur(28px) saturate(180%);
  backdrop-filter:blur(28px) saturate(180%);
  border-top:1px solid rgba(255,255,255,.12);
  border-top-left-radius:22px;
  border-top-right-radius:22px;
  display:flex;flex-direction:column;
  transform:translateY(100%);
  transition:transform .38s cubic-bezier(.2,1.1,.4,1);
  z-index:200;
  box-shadow:0 -20px 60px rgba(0,0,0,.55);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
.panel.show{transform:translateY(0);}
.panel-handle{
  height:22px;flex-shrink:0;
  display:flex;align-items:center;justify-content:center;
}
.panel-handle::before{
  content:'';width:38px;height:4px;border-radius:2px;
  background:rgba(255,255,255,.2);
}
.panel-head{
  padding:4px 20px 14px;flex-shrink:0;
  display:flex;align-items:center;justify-content:space-between;
  border-bottom:1px solid rgba(255,255,255,.07);
}
.panel-title{
  font-size:16px;font-weight:800;color:#fff;
  letter-spacing:.3px;
  display:flex;align-items:center;gap:8px;
}
.panel-title::before{
  content:'';width:4px;height:16px;border-radius:2px;
  background:linear-gradient(180deg,#ffd166,#f5a623);
}
.panel-close{
  width:32px;height:32px;border-radius:9px;
  background:rgba(255,255,255,.06);
  border:1px solid rgba(255,255,255,.1);
  color:#8a8aa8;font-size:15px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  font-family:inherit;transition:.15s;
}
.panel-close:active{background:rgba(255,255,255,.15);color:#fff;}
.panel-body{
  flex:1;overflow-y:auto;
  padding:16px 20px 24px;
  -webkit-overflow-scrolling:touch;
}
.panel-body::-webkit-scrollbar{width:4px;}
.panel-body::-webkit-scrollbar-thumb{
  background:rgba(255,255,255,.15);border-radius:2px;
}

/* ==================== 个人卡片 ==================== */
.profile-card{
  display:flex;align-items:center;gap:14px;
  padding:16px;
  border-radius:16px;
  background:linear-gradient(135deg,rgba(255,209,102,.14),rgba(124,92,255,.1));
  border:1px solid rgba(255,209,102,.22);
  -webkit-backdrop-filter:blur(12px);
  backdrop-filter:blur(12px);
  margin-bottom:18px;
}
.profile-avatar{
  width:54px;height:54px;border-radius:50%;
  background:linear-gradient(135deg,#ffd166,#f5a623);
  display:flex;align-items:center;justify-content:center;
  font-size:26px;flex-shrink:0;
  box-shadow:0 6px 20px rgba(255,209,102,.4),
             inset 0 -3px 8px rgba(0,0,0,.15),
             inset 0 3px 8px rgba(255,255,255,.35);
}
.profile-info{flex:1;min-width:0;}
.profile-name{
  font-size:15px;font-weight:800;color:#fff;
  margin-bottom:4px;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;
}
.profile-balance{
  display:flex;align-items:baseline;gap:6px;
}
.profile-balance-label{
  font-size:10.5px;color:#8a8aa8;
}
.profile-balance-value{
  font-size:18px;font-weight:900;color:#ffd166;
  font-variant-numeric:tabular-nums;
}

/* ==================== 统计卡片 ==================== */
.stat-grid{
  display:grid;grid-template-columns:repeat(2,1fr);
  gap:10px;
  margin-bottom:4px;
}
.stat-card{
  padding:13px 14px;border-radius:14px;
  background:rgba(255,255,255,.05);
  -webkit-backdrop-filter:blur(10px);
  backdrop-filter:blur(10px);
  border:1px solid rgba(255,255,255,.09);
}
.stat-label{
  font-size:11px;color:#6a6a80;
  letter-spacing:.4px;margin-bottom:5px;
}
.stat-value{
  font-size:19px;font-weight:800;
  font-variant-numeric:tabular-nums;line-height:1.2;
  color:#fff;
}
.stat-value.gold{color:#ffd166;}
.stat-value.cyan{color:#22d3ee;}
.stat-value.green{color:#4ade80;}
.stat-value.red{color:#ff5555;}

/* ==================== 设置 ==================== */
.setting-item{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 2px;
  border-bottom:1px solid rgba(255,255,255,.06);
}
.setting-item:last-of-type{border-bottom:0;}
.setting-label{
  font-size:13.5px;color:#fff;font-weight:600;
}
.setting-desc{
  font-size:11px;color:#6a6a80;margin-top:3px;
}
.switch{
  width:48px;height:28px;border-radius:14px;
  background:rgba(255,255,255,.1);
  border:1px solid rgba(255,255,255,.1);
  position:relative;cursor:pointer;
  transition:.22s;flex-shrink:0;
  touch-action:manipulation;
}
.switch::after{
  content:'';position:absolute;top:2px;left:2px;
  width:22px;height:22px;border-radius:50%;
  background:#808098;
  transition:.22s cubic-bezier(.2,1.4,.4,1);
}
.switch.on{
  background:rgba(255,209,102,.28);
  border-color:rgba(255,209,102,.5);
}
.switch.on::after{
  transform:translateX(20px);
  background:#ffd166;
  box-shadow:0 0 10px rgba(255,209,102,.65);
}
.reset-btn{
